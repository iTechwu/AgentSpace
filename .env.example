# PostgreSQL.
SELF_HOSTED_DATABASE_URL=postgres://dofe_agent:dofe_agent@127.0.0.1:5432/dofe_agent
SELF_HOSTED_DATABASE_DIRECT_URL=postgres://dofe_agent:dofe_agent@127.0.0.1:5432/dofe_agent

# E2E and database integration tests must use a separate database.
DOFE_AGENT_TEST_DATABASE_URL=postgres://dofe_agent:dofe_agent@127.0.0.1:5432/dofe_agent_test

# Volcengine TOS is the default attachment backend. Keep credentials only in the
# deployment secret store. The public endpoint is used by default so local
# development works. Enable TOS_USE_INTERNAL_ENDPOINT only inside a Volcengine VPC.
ATTACHMENT_STORAGE_PROVIDER=tos
TOS_BUCKET=replace_with_tos_bucket
TOS_REGION=cn-beijing
TOS_ENDPOINT=https://tos-<region>.volces.com
TOS_INTERNAL_ENDPOINT=
# Legacy S3-compatible endpoint aliases are accepted and normalized automatically.
# TOS_S3_ENDPOINT=
# TOS_INTERNAL_S3_ENDPOINT=
TOS_USE_INTERNAL_ENDPOINT=false
# Optional custom domain for signed browser download URLs.
TOS_BUCKET_DOMAIN=
TOS_ACCESS_KEY=replace_with_tos_access_key
TOS_SECRET_KEY=replace_with_tos_secret_key
# A self-hosted deployment without TOS may explicitly opt into a local fallback.
# Its root must be persisted by the deployment and must not be publicly served.
# ATTACHMENT_STORAGE_PROVIDER=local
# ATTACHMENT_ENABLE_LOCAL_FALLBACK=true
# SELF_HOSTED_ATTACHMENT_LOCAL_ROOT=/srv/DofeAgent/data/attachments

# agent.dofe web app base URL
DOFE_AGENT_APP_URL=http://127.0.0.1:1455

# Public brand commitments shown on the landing page.
NEXT_PUBLIC_BRAND_VISION=成为受世界尊敬的中国企业
NEXT_PUBLIC_BRAND_MISSION=成就中国智造的全球竞争力

# Dofe SSO is the only user identity and login provider. Configure these values
# in your deployment secret store; never commit SSO_CLIENT_SECRET or
# INTERNAL_API_SECRET.
SSO_API_URL=https://sso.ixicai.cn/api
SSO_INTERNAL_API_URL=https://sso.ixicai.cn/api
SSO_ISSUER=https://sso.ixicai.cn/api
SSO_CLIENT_ID=dofe-agent-dofe-ai-dev
SSO_CLIENT_SECRET=replace_with_sso_client_secret
SSO_SERVICE_NAME=dofe-agent.local.dofe.ai
INTERNAL_API_SECRET=replace_with_sso_internal_api_secret
# models.dofe.ai control-plane API (managed RuntimeCredential provisioning).
# The HMAC signature reuses the shared
# INTERNAL_API_SECRET (must equal models' INTERNAL_API_SECRET) and the caller
# identity reuses SSO_SERVICE_NAME; that service name must be allow-listed in
# models' MODELS_RUNTIME_CREDENTIAL_SERVICE_NAMES. Set MODELS_SERVICE_NAME /
# MODELS_INTERNAL_API_SECRET only to override per target.
MODELS_BASE_URL=https://model.local.dofe.ai/api
# Local Models allows this development caller for managed runtime credentials.
MODELS_SERVICE_NAME=agentspace-dofe-ai-dev
# Provider-compatible inference gateway used by managed runtime containers.
MODELS_GATEWAY_BASE_URL=https://model.local.dofe.ai/api
MANAGED_RUNTIME_PREFLIGHT_CHARGE_USD=0.01
# Keep local unless this deployment has approved managed nodes and models credentials.
DOFE_AGENT_RUNTIME_MODE=local
# Required when DOFE_AGENT_RUNTIME_MODE=remote.
DOFE_AGENT_RUNTIME_CREDENTIAL_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
DOFE_AGENT_RUNTIME_CREDENTIAL_VAULT_DIR=./data/runtime-credential-vault
# Absolute server directories from which workspace admins may import Skills.
# Separate multiple roots with the platform path delimiter (":" on Linux/macOS).
DOFE_AGENT_SKILL_LOCAL_IMPORT_ROOTS=/srv/dofe-agent/skills
# Required to enable the MCP center (connection secrets + task-session grants).
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# Rotate by replacing the value, re-encrypting stored MCP secrets, and redeploying.
DOFE_AGENT_MCP_SECRET_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
# Envelope version written by the current key. Increment before running the MCP key rotation command.
DOFE_AGENT_MCP_SECRET_ENCRYPTION_KEY_VERSION=mcp1
# JSON keyring for decrypting old envelopes during rotation, e.g. {"mcp1":"<old-base64-key>"}.
DOFE_AGENT_MCP_SECRET_ENCRYPTION_PREVIOUS_KEYS={}
# OpenMontage service integration. Generate two independent high-entropy values
# and configure the same values on the OpenMontage deployment. The service token
# authenticates AgentSpace calls; the signing secret verifies callbacks.
OPENMONTAGE_BASE_URL=http://127.0.0.1:8765
OPENMONTAGE_SERVICE_TOKEN=replace_with_a_long_random_service_token
OPENMONTAGE_EVENT_SIGNING_SECRET=replace_with_a_different_long_random_signing_secret
# MCP egress leases use Ed25519 so the proxy can verify without holding the
# control-plane signing key. Generate outside the repository:
#   openssl genpkey -algorithm ED25519 -out /absolute/path/mcp-egress-private.pem
#   openssl pkey -in /absolute/path/mcp-egress-private.pem -pubout -out /absolute/path/mcp-egress-public.pem
# The control plane reads the private key; Compose mounts only the public key.
MCP_EGRESS_PROXY_LEASE_SIGNING_PRIVATE_KEY_FILE=/absolute/path/mcp-egress-private.pem
MCP_EGRESS_PROXY_LEASE_VERIFY_PUBLIC_KEY_HOST_FILE=/absolute/path/mcp-egress-public.pem
# Use a comma-separated previous,next pair during rotation. The control plane
# uses one matching MCP_EGRESS_PROXY_ADMIN_TOKEN for policy push/revoke.
MCP_EGRESS_PROXY_ADMIN_TOKEN=replace_with_a_long_random_admin_token
MCP_EGRESS_PROXY_ADMIN_TOKENS=replace_with_a_long_random_admin_token
# MCP gateway experimental opt-ins. BOTH default OFF until real CLI E2E (call,
# revoke, audit, lifecycle) passes in the designated CI env — "being able to
# build launch args" is not "supported". With both unset, no runtime shows as
# MCP-eligible in the market UI.
# MCP_CLAUDE_EXPERIMENTAL_ENABLED=1
# MCP_CODEX_EXPERIMENTAL_ENABLED=1
MANAGED_RUNTIME_IMAGE_TAG=latest
# Required by managed nodes in remote mode. This must be a pre-created network
# whose egress policy only permits the models gateway and approved dependencies.
MANAGED_RUNTIME_DOCKER_NETWORK=dofe-models-egress
# Local managed nodes may need to route a development gateway hostname to the
# Docker host and trust the local development CA.
# MANAGED_RUNTIME_DOCKER_EXTRA_HOSTS=model.local.dofe.ai:host-gateway
# MANAGED_RUNTIME_TLS_CA_PATH=/absolute/path/to/rootCA.pem
# Catalog admission accepts image templates only from these registries.
DOFE_AGENT_SKILL_SERVICE_ALLOWED_REGISTRIES=docker.io,ghcr.io
# Authenticates the internal provisioning/cleanup maintenance route.
CRON_SECRET=replace_with_a_long_random_secret
SSO_REDIRECT_URI=https://dofe-agent.local.dofe.ai/auth/callback
JWKS_PATH=.well-known/jwks.json
JWKS_URI=https://sso.ixicai.cn/api/.well-known/jwks.json
INTERNAL_JWKS_URI=https://sso.ixicai.cn/api/.well-known/jwks.json
SSO_DISCOVERY_URL=https://sso.ixicai.cn/api/.well-known/openid-configuration

# Required for self-hosted production builds that use Next.js Server Actions.
# Use the same value for every web instance and every build of the same deployment.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
