# 统一 .dockerignore（构建上下文为仓库根 deploy/*/docker-compose.yml 的 context: ../..）。
# Docker 内依赖通过 pnpm install 重新安装、产物通过各 Dockerfile 的 RUN 重新构建，
# 以下内容一律不进 build context（此前无 ignore，约 13 GiB 的 .next/node_modules 全量进 context）。

# 版本控制与本地元数据
.git
.gitignore
.DS_Store

# 依赖与构建产物（容器内重建）
node_modules
**/node_modules
.next
**/.next
dist
**/dist
dist-types
**/dist-types
.turbo
**/.turbo
*.tsbuildinfo
dofe-agent-daemon-*.tgz

# 运行时数据与产物目录
data
runtime-output
agent-output.json
artifacts

# 本地环境与凭证（示例模板除外）
.env
.env.*
!.env.example
*.env

# 文档 / 设计 / 本地工作笔记（不入镜像）
docs
Design
PR
TODO
example
demo
findings.md
progress.md
task_plan.md

# 本地工具与代理缓存
.pnpm-store
.agentspace-dev
.agentspace-record
.agentspace-record-live
.claude
.codex
.code-review-graph
.worktrees

# 测试与覆盖率产物
coverage
playwright-report
test-results
*.log
