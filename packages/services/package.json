{
  "name": "@dofe-agent/services",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "sh -c 'node --experimental-strip-types scripts/verify-test-coverage.mjs && for file in src/skills/*.test.ts src/skills/package/*.test.ts src/mcp-center/*.test.ts src/skill-services/*.test.ts src/openmontage/*.test.ts src/workflows/*.test.ts; do node --env-file-if-exists=../../.env --experimental-strip-types --test --test-concurrency=1 \"$file\" || exit 1; done' --",
    "types": "../../apps/web/node_modules/.bin/tsc -p tsconfig.types.json --incremental false"
  },
  "dependencies": {
    "@dofe-agent/db": "workspace:*",
    "@dofe-agent/domain": "workspace:*",
    "@dofe/models-sdk": "^0.5.5",
    "@larksuiteoapi/node-sdk": "^1.67.0",
    "@volcengine/tos-sdk": "^2.9.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cron-parser": "^5.7.0",
    "fflate": "^0.8.2",
    "yaml": "^2.7.0"
  },
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./storage/storage-scan": {
      "types": "./dist-types/storage/storage-scan.d.ts",
      "default": "./src/storage/storage-scan.ts"
    },
    "./storage/workspace-purge": {
      "types": "./dist-types/storage/workspace-purge.d.ts",
      "default": "./src/storage/workspace-purge.ts"
    },
    "./mcp-center/egress": {
      "types": "./dist-types/mcp-center/egress.d.ts",
      "default": "./src/mcp-center/egress.ts"
    },
    "./mcp-center/security": {
      "types": "./dist-types/mcp-center/security.d.ts",
      "default": "./src/mcp-center/security.ts"
    }
  }
}
