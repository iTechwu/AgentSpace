{
  "name": "@dofe-agent/services",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "sh -c 'node --experimental-strip-types scripts/verify-test-coverage.mjs && for file in src/runtime-maintenance/*.test.ts src/skills/*.test.ts src/skills/package/*.test.ts src/mcp-center/*.test.ts src/skill-services/*.test.ts src/openmontage/*.test.ts src/workflows/*.test.ts src/attachments/storage.test.ts src/attachments/tos-signer.test.ts; do node --env-file-if-exists=../../.env --experimental-strip-types --test --test-concurrency=1 \"$file\" || exit 1; done' --",
    "test:tos": "node --env-file-if-exists=../../.env --experimental-strip-types --test --test-concurrency=1 src/attachments/storage-tos.integration.test.ts",
    "types": "../../apps/web/node_modules/.bin/tsc -p tsconfig.types.json --incremental false"
  },
  "dependencies": {
    "@dofe-agent/db": "workspace:*",
    "@dofe-agent/domain": "workspace:*",
    "@dofe/models-sdk": "^0.5.7",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cron-parser": "^5.8.1",
    "fflate": "^0.8.2",
    "mammoth": "^1.8.0",
    "pdf-parse": "^2.4.5",
    "pptx2json": "^0.0.10",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.7.0"
  },
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./storage/storage-scan": {
      "types": "./dist-types/storage/storage-scan.d.ts",
      "default": "./src/storage/storage-scan.ts"
    },
    "./storage/workspace-purge": {
      "types": "./dist-types/storage/workspace-purge.d.ts",
      "default": "./src/storage/workspace-purge.ts"
    },
    "./mcp-center/egress": {
      "types": "./dist-types/mcp-center/egress.d.ts",
      "default": "./src/mcp-center/egress.ts"
    },
    "./mcp-center/security": {
      "types": "./dist-types/mcp-center/security.d.ts",
      "default": "./src/mcp-center/security.ts"
    }
  },
  "engines": {
    "node": "^25.9.0"
  }
}
