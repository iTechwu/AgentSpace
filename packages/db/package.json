{
  "name": "@dofe-agent/db",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./postgres": {
      "types": "./dist-types/postgres.d.ts",
      "default": "./src/postgres.ts"
    },
    "./postgres-schema": {
      "types": "./dist-types/postgres-schema.d.ts",
      "default": "./src/postgres-schema.ts"
    }
  },
  "scripts": {
    "test": "sh -c 'for file in src/skill-service-operations.test.ts src/skill-services.test.ts src/skill-runner-invocations.test.ts src/employee-data-legal-holds.test.ts src/openmontage-jobs.test.ts src/workflows/*.test.ts; do node --env-file-if-exists=../../.env --experimental-strip-types --test --test-concurrency=1 \"$file\" || exit 1; done' --",
    "types": "../../apps/web/node_modules/.bin/tsc -p tsconfig.types.json --incremental false",
    "postgres": "node --experimental-strip-types ./src/postgres-cli.ts",
    "postgres:status": "node --experimental-strip-types ./src/postgres-cli.ts status",
    "postgres:init": "node --experimental-strip-types ./src/postgres-cli.ts init",
    "postgres:migrate": "node --experimental-strip-types ./src/postgres-cli.ts migrate-from-sqlite",
    "postgres:cutover-plan": "node --experimental-strip-types ./src/postgres-cli.ts cutover-plan",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:pull": "prisma db pull --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:diff": "prisma migrate diff --from-schema-datasource db --to-schema-datamodel prisma/schema.prisma --exit-code --schema prisma/schema.prisma",
    "postinstall": "prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@dofe-agent/domain": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.1",
    "typescript": "^5.9.3"
  }
}
