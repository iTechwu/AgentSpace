  @@index([workspace_id, requester_user_id, status, created_at(sort: Desc)], map: "idx_agent_access_request_requester_status")
  @@index([workspace_id, source_agent_name, status, created_at(sort: Desc)], map: "idx_agent_access_request_source_status")
}

