/// Immutable event ledger for workspace-level actions (user/admin operations, lifecycle events).
model AuditLog {
  id          String @id
  workspaceId String @map("workspace_id")

  title       String /// Human-readable event title.
  note        String /// Event detail / body.
  code        String? /// Optional machine-readable event code.
  dataJson    Json    @default("{}") @map("data_json") /// Arbitrary structured payload serialized as JSON.
  source      String  @default("workspace_snapshot_ledger") /// Event source domain (e.g. runtime_lifecycle).
  sourceIndex Int     @default(0) @map("source_index") /// Ordering hint within a source.

  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspaceId, createdAt(sort: Desc), sourceIndex(sort: Desc)], map: "idx_audit_log_workspace_created")
  @@map("audit_log")
}

