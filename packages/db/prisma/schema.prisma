/// Assignment of a skill to an agent/employee within a workspace.
model AgentSkill {
  workspaceId         String            @map("workspace_id")
  agentId             String            @map("agent_id")
  employeeName        String            @map("employee_name") /// Human-readable employee/agent name (denormalized).
  skillId             String            @map("skill_id")
  createdAt           DateTime          @map("created_at") @db.Timestamptz(6)
  skillArtifactDigest String?           @map("skill_artifact_digest") /// Pinned artifact digest for this agent, if any.
  rolloutPin          String?           @map("rollout_pin") /// Optional rollout policy pin.
  employeeId          String            @map("employee_id")
  skill               Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspaceEmployee   WorkspaceEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_agent_skill_employee_id")

  @@id([workspaceId, employeeId, skillId])
  @@index([workspaceId, employeeName], map: "idx_agent_skill_employee")
  @@map("agent_skill")
}

