// AgentSpace Prisma schema — generated by `prisma db pull` from the desensitized test
// database agent_space_test (PostgreSQL, schema version 116) and verified drift-free:
//   prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma
//   -> "No difference detected".
//
// Naming convention (Phase A): models are PascalCase with @@map("snake_table"), fields
// are camelCase with @map("snake_col"). Physical tables/columns are unchanged 1:1 —
// @map/@@map are surface-only and produce NO migration (verified drift-free: migrate diff
// -> "No difference detected"). 124 models, 270 relations, 110 Json fields,
// 46 partial indexes (preview feature `partialIndexes`).
//
// Prisma CANNOT represent the following objects — they live as raw SQL in
// prisma/migrations/0_init/migration.sql and are excluded from drift diff:
//   - 5 triggers + 5 plpgsql functions (schema-version monotonic guard, workflow
//     history_sequence, token-usage snapshot/billing, employee display-name sync)
//   - pgcrypto extension (workspace_employee.id DEFAULT gen_random_uuid())
//   - 3 expression indexes with COALESCE keys
//   - 2 CREATE INDEX CONCURRENTLY (workflow_run history indexes)
//   - ~13 CHECK constraints (enums are modeled as TEXT + CHECK, not PG enums)
//
// Re-running `prisma db pull` overwrites this file and reverts the PascalCase/camelCase
// formatting to snake_case-native — re-apply the Phase A codemod or avoid db pull. Do so
// only deliberately.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

