  joinCode            String?   @unique(map: "idx_workspace_join_code", where: raw("(join_code IS NOT NULL)")) @map("join_code") /// Optional invite code for self-join (partial unique when set).
  joinCodeUpdatedAt   DateTime? @map("join_code_updated_at") @db.Timestamptz(6)
  joinCodeUpdatedBy   String?   @map("join_code_updated_by")
