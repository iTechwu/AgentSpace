  @@unique([workspaceId, eventId], map: "idx_runtime_mcp_tool_audit_event")
  @@index([workspaceId, connectionId, createdAt(sort: Desc)], map: "idx_runtime_mcp_tool_audit_connection")
  @@index([createdAt], map: "idx_runtime_mcp_tool_audit_created")
