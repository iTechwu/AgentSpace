/// SSO tenant/team binding for a workspace; one binding per workspace.
model WorkspaceSsoBinding {
  workspaceId String    @id @map("workspace_id")
  tenantId    String    @unique(map: "idx_workspace_sso_binding_tenant_unique", where: raw("(source = 'tenant'::text)")) @map("tenant_id") /// External SSO tenant identifier.
  tenantSlug  String?   @map("tenant_slug")
  tenantName  String    @map("tenant_name")
  teamId      String?   @unique(map: "idx_workspace_sso_binding_team_unique", where: raw("(team_id IS NOT NULL)")) @map("team_id") /// Optional external team identifier.
  teamSlug    String?   @map("team_slug")
  teamName    String?   @map("team_name")
  source      String /// tenant | team — indicates which external scope is authoritative.
  syncedAt    DateTime  @map("synced_at") @db.Timestamptz(6) /// Last time the binding was refreshed from the IdP.
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([teamId], map: "idx_workspace_sso_binding_team")
  @@map("workspace_sso_binding")
}

model WorkspaceTask {
