  @@index([workspaceId, requesterUserId, status, createdAt(sort: Desc)], map: "idx_agent_access_request_requester_status")
  @@index([workspaceId, sourceAgentName, status, createdAt(sort: Desc)], map: "idx_agent_access_request_source_status")
  @@map("agent_access_request")
}

