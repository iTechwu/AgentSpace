  agentRouterEvent                      AgentRouterEvent[]
  agentRouterProviderSession            AgentRouterProviderSession[]
  agentRouterSession                    AgentRouterSession[]
  agentRuntime                          AgentRuntime[]
  agentSkill                            AgentSkill[]
  agentSkillRequirementConfig           AgentSkillRequirementConfig[]
