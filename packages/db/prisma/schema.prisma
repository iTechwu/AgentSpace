  createdAt            DateTime             @map("created_at") @db.Timestamptz(6)
  startedAt            DateTime?            @map("started_at") @db.Timestamptz(6)
  completedAt          DateTime?            @map("completed_at") @db.Timestamptz(6)
  source               String               @default("user_verify")
  stage                String               @default("queued")
  failedStage          String?              @map("failed_stage")
  stageUpdatedAt       DateTime             @default(now()) @map("stage_updated_at") @db.Timestamptz(6)
  runtimeMcpConnection RuntimeMcpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                Users?               @relation(fields: [requestedByUserId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  agentRuntime         AgentRuntime         @relation(fields: [runtimeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspaceId, connectionId, createdAt(sort: Desc)], map: "idx_runtime_mcp_operation_connection")
  @@index([workspaceId, runtimeId, status, createdAt], map: "idx_runtime_mcp_operation_runtime_status")
  @@map("runtime_mcp_operation")
}

model RuntimeMcpSecret {
