  contentBlob                           ContentBlob[]
  daemonApiToken                        DaemonApiToken[]
  daemonConnection                      DaemonConnection[]
  documentAgentAccess                   DocumentAgentAccess[]
  documentPermissionRequest             DocumentPermissionRequest[]
  employeeArtifact                      EmployeeArtifact[]
  employeeDataLegalHold                 EmployeeDataLegalHold[]
  employeePersistentWorkspace           EmployeePersistentWorkspace[]
  employeeRecoveryOperation             EmployeeRecoveryOperation[]
  employeeRuntimeBinding                EmployeeRuntimeBinding[]
  employeeWorkspaceRevision             EmployeeWorkspaceRevision[]
  externalChannelBinding                ExternalChannelBinding[]
  externalDataOperationRun              ExternalDataOperationRun[]
  externalIntegration                   ExternalIntegration[]
  externalIntegrationEvent              ExternalIntegrationEvent[]
  externalMessageMapping                ExternalMessageMapping[]
  externalMessageOutbox                 ExternalMessageOutbox[]
  externalResourceBinding               ExternalResourceBinding[]
  externalThreadBinding                 ExternalThreadBinding[]
  externalUserBinding                   ExternalUserBinding[]
  knowledgePageAssignmentPolicy         KnowledgePageAssignmentPolicy[]
  knowledgeProposal                     KnowledgeProposal[]
  managedRuntimeCleanupRequest          ManagedRuntimeCleanupRequest[]
  managedSkillService                   ManagedSkillService[]
  managedSkillServiceOperation          ManagedSkillServiceOperation[]
  mcpCatalogItem                        McpCatalogItem[]
  mcpTaskAuditAuthorization             McpTaskAuditAuthorization[]
  mcpTaskSessionGrant                   McpTaskSessionGrant[]
  openmontageArtifactGrant              OpenmontageArtifactGrant[]
  openmontageChatBinding                OpenmontageChatBinding[]
  openmontageDelegationIntent           OpenmontageDelegationIntent[]
  openmontageJobEvent                   OpenmontageJobEvent[]
  openmontageJobLink                    OpenmontageJobLink[]
  openmontageJobProjection              OpenmontageJobProjection[]
  openmontageNotificationOutbox         OpenmontageNotificationOutbox[]
  pagerAlertState                       PagerAlertState[]
  providerAccount                       ProviderAccount[]
  runtimeAppOperation                   RuntimeAppOperation[]
  runtimeAppPackage                     RuntimeAppPackage[]
  runtimeAppRelease                     RuntimeAppRelease[]
  runtimeAppSkillBinding                RuntimeAppSkillBinding[]
  runtimeCredentialReconciliationTarget RuntimeCredentialReconciliationTarget[]
  runtimeCredentialRecoveryTask         RuntimeCredentialRecoveryTask[]
  runtimeInstalledApp                   RuntimeInstalledApp[]
  runtimeMcpConnection                  RuntimeMcpConnection[]
  runtimeMcpDiscoverySnapshot           RuntimeMcpDiscoverySnapshot[]
  runtimeMcpOperation                   RuntimeMcpOperation[]
  runtimeMcpToolAudit                   RuntimeMcpToolAudit[]
  runtimeProvisionRequest               RuntimeProvisionRequest[]
  runtimeProvisioningTask               RuntimeProvisioningTask[]
  skill                                 Skill[]
  skillArtifact                         SkillArtifact[]
  skillArtifactBinding                  SkillArtifactBinding[]
