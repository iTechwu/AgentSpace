  daemonTokenId     String?         @map("daemon_token_id")
  createdAt         DateTime        @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @map("updated_at") @db.Timestamptz(6)
  daemonApiToken    DaemonApiToken? @relation(fields: [daemonTokenId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  providerAccount   ProviderAccount @relation(fields: [providerAccountId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspaceId, status, createdAt(sort: Desc)], map: "idx_runtime_provision_request_workspace")
  @@map("runtime_provision_request")
}

model RuntimeProvisioningTask {
  id                           String                         @id
  workspaceId                  String                         @map("workspace_id")
  runtimeId                    String?                        @map("runtime_id")
  requestedByUserId            String                         @map("requested_by_user_id")
  idempotencyKey               String                         @map("idempotency_key")
  sourceRuntimeId              String?                        @map("source_runtime_id")
  runtimeType                  String                         @map("runtime_type")
  protocolsJson                Json                           @default("[]") @map("protocols_json")
  requestedModel               String?                        @map("requested_model")
  targetServer                 String?                        @map("target_server")
  stage                        String                         @default("pending")
  stageStatus                  String                         @default("pending") @map("stage_status")
  progressPercent              Int                            @default(0) @map("progress_percent")
  retryCount                   Int                            @default(0) @map("retry_count")
  maxRetries                   Int                            @default(3) @map("max_retries")
  lastErrorCode                String?                        @map("last_error_code")
  lastErrorMessage             String?                        @map("last_error_message")
  cleanupStatus                String                         @default("pending") @map("cleanup_status")
  cleanupResultJson            Json?                          @map("cleanup_result_json")
  runtimeCredentialId          String?                        @map("runtime_credential_id")
  secretRef                    String?                        @map("secret_ref")
  configRef                    String?                        @map("config_ref")
  status                       String                         @default("queued")
  timeoutsJson                 Json                           @default("{}") @map("timeouts_json")
  startedAt                    DateTime?                      @map("started_at") @db.Timestamptz(6)
  completedAt                  DateTime?                      @map("completed_at") @db.Timestamptz(6)
  createdAt                    DateTime                       @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime                       @map("updated_at") @db.Timestamptz(6)
  daemonConnectionId           String?                        @map("daemon_connection_id")
  stageStartedAt               DateTime?                      @map("stage_started_at") @db.Timestamptz(6)
  requestedName                String?                        @map("requested_name")
  allowedModelsJson            Json                           @default("[]") @map("allowed_models_json")
  taskTimeoutMs                Int                            @default(1800000) @map("task_timeout_ms")
  nextRetryAt                  DateTime?                      @map("next_retry_at") @db.Timestamptz(6)
  managedRuntimeCleanupRequest ManagedRuntimeCleanupRequest[]
  daemonConnection             DaemonConnection?              @relation(fields: [daemonConnectionId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  users                        Users                          @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agentRuntime                 AgentRuntime?                  @relation(fields: [runtimeId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  workspace                    Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  runtimeProvisioningTaskEvent RuntimeProvisioningTaskEvent[]

  @@unique([workspaceId, idempotencyKey])
  @@index([daemonConnectionId, status, stageStatus], map: "idx_runtime_provisioning_task_daemon_running")
  @@index([status, nextRetryAt], map: "idx_runtime_provisioning_task_retry")
  @@index([runtimeId], map: "idx_runtime_provisioning_task_runtime")
  @@index([status, stageStatus, stageStartedAt], map: "idx_runtime_provisioning_task_stage_timeout")
  @@index([workspaceId, status, createdAt(sort: Desc)], map: "idx_runtime_provisioning_task_workspace_status")
  @@map("runtime_provisioning_task")
}

model RuntimeProvisioningTaskEvent {
  id                      String                  @id
  taskId                  String                  @map("task_id")
  stage                   String
  status                  String
  progressPercent         Int                     @default(0) @map("progress_percent")
  title                   String
  summary                 String?
  severity                String                  @default("info")
  dataJson                Json?                   @map("data_json")
  createdAt               DateTime                @map("created_at") @db.Timestamptz(6)
  runtimeProvisioningTask RuntimeProvisioningTask @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([taskId, createdAt], map: "idx_runtime_provisioning_task_event_task")
  @@map("runtime_provisioning_task_event")
}

model RuntimeWorkspaceMountOperation {
  id                String            @id
  workspaceId       String            @map("workspace_id")
  runtimeId         String            @map("runtime_id")
  employeeName      String            @map("employee_name")
  headRevisionId    String?           @map("head_revision_id")
  status            String
  claimedAt         DateTime?         @map("claimed_at") @db.Timestamptz(6)
  completedAt       DateTime?         @map("completed_at") @db.Timestamptz(6)
  errorCode         String?           @map("error_code")
  errorMessage      String?           @map("error_message")
  createdAt         DateTime          @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @map("updated_at") @db.Timestamptz(6)
  materializedFiles Int?              @map("materialized_files")
  mountedPath       String?           @map("mounted_path")
  leaseExpiresAt    DateTime?         @map("lease_expires_at") @db.Timestamptz(6)
  claimGeneration   Int               @default(0) @map("claim_generation")
  employeeId        String            @map("employee_id")
  workspaceEmployee WorkspaceEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_runtime_workspace_mount_employee_id")

  @@index([workspaceId, runtimeId, status], map: "idx_runtime_workspace_mount_claim")
  @@index([workspaceId, employeeId, createdAt(sort: Desc)], map: "idx_runtime_workspace_mount_employee_id")
  @@map("runtime_workspace_mount_operation")
}

/// Authenticated browser/API session for a user.
model Session {
  id         String    @id
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash") /// Hash of the session token.
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6) /// Absolute expiration time.
  lastSeenAt DateTime  @map("last_seen_at") @db.Timestamptz(6) /// Last request timestamp for activity tracking.
  createdAt  DateTime  @map("created_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6) /// Set when the session is explicitly revoked.
  users      Users     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_session_user")
  @@map("session")
}

/// Skill definition registered in a workspace.
model Skill {
  id                   String   @id
  workspaceId          String   @map("workspace_id")
  name                 String
  description          String   @default("")
  sourceType           String   @default("manual") @map("source_type") /// manual | git | marketplace, etc.
  sourceUrl            String?  @map("source_url") /// Origin URL when sourceType is external.
  configJson           Json     @default("{}") @map("config_json") /// Default skill configuration schema/values.
  createdAt            DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @map("updated_at") @db.Timestamptz(6)
  activeArtifactDigest String?  @map("active_artifact_digest") /// Digest of the artifact currently marked active.

  // --- relations ---
  agentSkill                  AgentSkill[]
  agentSkillRequirementConfig AgentSkillRequirementConfig[]
  runtimeAppSkillBinding      RuntimeAppSkillBinding[]
  workspace                   Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  skillArtifact               SkillArtifact[]
  skillArtifactBinding        SkillArtifactBinding[]
  skillDraft                  SkillDraft[]
  skillFile                   SkillFile[]
  skillImportEvent            SkillImportEvent[]
  skillInstallApproval        SkillInstallApproval[]
  skillUpgradeApproval        SkillUpgradeApproval[]

  @@unique([workspaceId, name])
  @@index([workspaceId, name], map: "idx_skill_workspace_name")
  @@map("skill")
}

/// Immutable packaged version of a skill (manifest + files).
model SkillArtifact {
  id                String              @id
  workspaceId       String              @map("workspace_id")
  digest            String /// Content-addressable artifact digest.
  skillId           String?             @map("skill_id")
  name              String
  version           String              @default("")
  manifestVersion   Int                 @default(1) @map("manifest_version") /// Schema version of manifest_json.
  manifestJson      Json                @map("manifest_json") /// Artifact manifest (entrypoints, dependencies, etc.).
  sourceType        String              @default("manual") @map("source_type")
  sourceUrl         String?             @map("source_url")
  provenanceJson    Json                @default("{}") @map("provenance_json") /// Build/publish provenance metadata.
  fileCount         Int                 @default(0) @map("file_count")
  totalSizeBytes    BigInt              @default(0) @map("total_size_bytes")
  legacyIncomplete  Int                 @default(0) @map("legacy_incomplete") /// Migration flag for legacy artifacts.
  createdAt         DateTime            @map("created_at") @db.Timestamptz(6)
  skill             Skill?              @relation(fields: [skillId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  skillArtifactFile SkillArtifactFile[]

  @@unique([workspaceId, digest])
  @@index([workspaceId, skillId], map: "idx_skill_artifact_skill")
  @@index([workspaceId, digest], map: "idx_skill_artifact_workspace_digest")
  @@map("skill_artifact")
}

/// Many-to-many binding between a skill and an artifact digest.
model SkillArtifactBinding {
  id             String    @id
  workspaceId    String    @map("workspace_id")
  skillId        String    @map("skill_id")
  artifactDigest String    @map("artifact_digest") /// Referenced artifact digest.
  createdAt      DateTime  @map("created_at") @db.Timestamptz(6)
  skill          Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workspaceId, skillId, artifactDigest])
  @@map("skill_artifact_binding")
}

/// A single file inside a skill artifact.
model SkillArtifactFile {
  id            String        @id
  artifactId    String        @map("artifact_id")
  workspaceId   String        @map("workspace_id")
  path          String
  sha256        String /// File content hash.
  sizeBytes     BigInt        @map("size_bytes") /// Uncompressed file size.
  mediaType     String        @map("media_type") /// MIME type or media classifier.
  mode          String        @default("0644")
  isText        Int           @default(0) @map("is_text") /// 1 if the file is text-encoded.
  createdAt     DateTime      @map("created_at") @db.Timestamptz(6)
  skillArtifact SkillArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([artifactId, path])
  @@index([workspaceId, sha256], map: "idx_skill_artifact_file_sha256")
  @@map("skill_artifact_file")
}

/// Unpublished work-in-progress draft of a skill.
model SkillDraft {
  workspaceId     String    @map("workspace_id")
  skillId         String    @map("skill_id")
  draftJson       Json      @map("draft_json") /// Serialized draft graph/code.
  updatedByUserId String?   @map("updated_by_user_id")
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(6)
  skill           Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([workspaceId, skillId])
  @@map("skill_draft")
}

/// Inline editable file attached to a skill (pre-artifact).
model SkillFile {
  id        String   @id
  skillId   String   @map("skill_id")
  path      String
  content   String /// File source content.
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([skillId, path])
  @@index([skillId], map: "idx_skill_file_skill")
  @@map("skill_file")
}

/// Audit trail of skill imports into a workspace.
model SkillImportEvent {
  id           String    @id
  workspaceId  String    @map("workspace_id")
  skillId      String?   @map("skill_id")
  skillName    String    @map("skill_name")
  sourceType   String    @map("source_type")
  sourceUrl    String?   @map("source_url")
  importMode   String    @default("created") @map("import_mode") /// created | updated | skipped.
  metadataJson Json      @default("{}") @map("metadata_json")
  importedAt   DateTime  @map("imported_at") @db.Timestamptz(6) /// When the import was recorded.
  skill        Skill?    @relation(fields: [skillId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspaceId, importedAt(sort: Desc)], map: "idx_skill_import_event_workspace_imported")
  @@map("skill_import_event")
}

/// Policy approval gate before installing a skill artifact.
model SkillInstallApproval {
  id                 String    @id
  workspaceId        String    @map("workspace_id")
  skillId            String?   @map("skill_id")
  artifactDigest     String    @map("artifact_digest") /// Artifact under review.
  releaseLockDigest  String    @map("release_lock_digest") /// Identifies the release lock being approved.
  policyVersion      String    @default("v1") @map("policy_version")
  riskDecisionDigest String    @map("risk_decision_digest") /// Hash of the risk assessment.
  decision           String /// approved | rejected.
  riskItemsJson      Json      @default("[]") @map("risk_items_json") /// Serialized risk findings.
  reason             String?
  actorUserId        String?   @map("actor_user_id")
  createdAt          DateTime  @map("created_at") @db.Timestamptz(6)
  consumedAt         DateTime? @map("consumed_at") @db.Timestamptz(6) /// Set when the approval is consumed by an install.
  users              Users?    @relation(fields: [actorUserId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  skill              Skill?    @relation(fields: [skillId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspaceId, artifactDigest, releaseLockDigest, policyVersion, riskDecisionDigest], map: "idx_skill_install_approval_lock")
  @@map("skill_install_approval")
}

/// Deployment of a skill artifact onto a runtime.
model SkillInstallation {
  id                           String                         @id
  workspaceId                  String                         @map("workspace_id")
  runtimeId                    String                         @map("runtime_id")
  artifactDigest               String                         @map("artifact_digest") /// Installed artifact digest.
  status                       String
  resolvedLockJson             Json                           @default("{}") @map("resolved_lock_json") /// Resolved dependency/service lock.
  preparedPath                 String?                        @map("prepared_path") /// Filesystem path prepared for the runtime.
  health                       String                         @default("unknown") /// unknown | healthy | unhealthy.
  previousReadyRevision        String?                        @map("previous_ready_revision")
  revision                     String /// Monotonic deployment revision.
  installedAt                  DateTime?                      @map("installed_at") @db.Timestamptz(6) /// When the installation became ready.
  verifiedAt                   DateTime?                      @map("verified_at") @db.Timestamptz(6) /// Last health verification timestamp.
  createdAt                    DateTime                       @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime                       @map("updated_at") @db.Timestamptz(6)
  previousReadyArtifactDigest  String?                        @map("previous_ready_artifact_digest")
  preparedDigest               String?                        @map("prepared_digest")
  managedSkillServiceOperation ManagedSkillServiceOperation[]
  agentRuntime                 AgentRuntime                   @relation(fields: [runtimeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspace                    Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  skillInstallationComponent   SkillInstallationComponent[]
  skillInstallationOperation   SkillInstallationOperation[]
  skillServiceBinding          SkillServiceBinding[]

  @@unique([workspaceId, runtimeId, artifactDigest, revision])
  @@map("skill_installation")
}

/// Individual component inside a skill installation.
model SkillInstallationComponent {
  id                String            @id
  installationId    String            @map("installation_id")
  kind              String /// Component category.
  key               String /// Component identifier.
  status            String
  errorCode         String?           @map("error_code")
  errorMessage      String?           @map("error_message")
  lastOperationId   String?           @map("last_operation_id") /// Last operation that touched this component.
  verifiedAt        DateTime?         @map("verified_at") @db.Timestamptz(6)
  updatedAt         DateTime          @map("updated_at") @db.Timestamptz(6)
  skillInstallation SkillInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([installationId, kind, key])
  @@map("skill_installation_component")
}

/// Mutable operation executed against a skill installation (install, verify, rollback, etc.).
model SkillInstallationOperation {
  id                  String            @id
  workspaceId         String            @map("workspace_id")
  runtimeId           String            @map("runtime_id")
  installationId      String            @map("installation_id")
  operation           String /// install | verify | rollback, etc.
  status              String
  requestSnapshotJson Json              @default("{}") @map("request_snapshot_json") /// Operation request payload.
  safeResultJson      Json              @default("{}") @map("safe_result_json") /// Sanitized operation result.
  errorCode           String?           @map("error_code")
  errorMessage        String?           @map("error_message")
  claimedAt           DateTime?         @map("claimed_at") @db.Timestamptz(6)
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(6)
  requestedByUserId   String?           @map("requested_by_user_id")
  createdAt           DateTime          @map("created_at") @db.Timestamptz(6)
  leaseExpiresAt      DateTime?         @map("lease_expires_at") @db.Timestamptz(6) /// Worker lease expiration (fencing).
  claimGeneration     Int               @default(0) @map("claim_generation") /// Lease generation counter.
  skillInstallation   SkillInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users               Users?            @relation(fields: [requestedByUserId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  agentRuntime        AgentRuntime      @relation(fields: [runtimeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("skill_installation_operation")
}

/// Record of a skill being invoked at runtime.
model SkillRunnerInvocation {
  id                String    @id
  workspaceId       String    @map("workspace_id")
  taskId            String?   @map("task_id")
  runtimeId         String?   @map("runtime_id")
  installationId    String?   @map("installation_id")
  skillId           String?   @map("skill_id")
  skillName         String    @map("skill_name")
  artifactDigest    String    @map("artifact_digest")
  revision          String?
  entrypointId      String    @map("entrypoint_id") /// Invoked entrypoint identifier.
  entrypointKey     String    @map("entrypoint_key") /// Invoked entrypoint key.
  entrypointPath    String?   @map("entrypoint_path") /// Invoked entrypoint file path, if any.
  entrypointRuntime String?   @map("entrypoint_runtime") /// Runtime qualifier for the entrypoint.
  actorId           String    @map("actor_id")
  actorType         String    @map("actor_type")
  resultCode        Int       @map("result_code") /// Execution result code.
  timedOut          Boolean   @default(false) @map("timed_out") /// True if the invocation timed out.
  durationMs        Int?      @map("duration_ms") /// Wall-clock execution time.
  safeSummary       String?   @map("safe_summary") /// Sanitized output summary.
  eventId           String?   @map("event_id")
  createdAt         DateTime  @map("created_at") @db.Timestamptz(6)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workspaceId, eventId])
  @@index([workspaceId, installationId, createdAt(sort: Desc)], map: "idx_skill_runner_invocation_installation")
  @@index([workspaceId, taskId, createdAt(sort: Desc)], map: "idx_skill_runner_invocation_task")
  @@map("skill_runner_invocation")
}

/// Binding between a skill installation and a managed service instance.
model SkillServiceBinding {
  installationId         String              @map("installation_id")
  serviceId              String              @map("service_id")
  catalogTemplateVersion String              @map("catalog_template_version") /// Version of the service catalog template.
  serviceImageDigest     String              @map("service_image_digest") /// Resolved service container image.
  endpointRef            String              @map("endpoint_ref") /// Service endpoint reference.
  healthRevision         String              @map("health_revision") /// Last known health revision.
