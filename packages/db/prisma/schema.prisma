  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(6)
  rotatedAt       DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  users           Users?    @relation(fields: [createdByUserId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workspaceId, host])
  @@map("workspace_git_credential")
}

model WorkspaceInvitation {
  id          String    @id
  workspaceId String    @map("workspace_id")
  email       String
  role        String    @default("member")
  tokenHash   String    @unique @map("token_hash")
  status      String    @default("active")
  invitedBy   String    @map("invited_by")
  createdAt   DateTime  @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspaceId, email, status], map: "idx_workspace_invitation_email")
  @@index([workspaceId, status, createdAt(sort: Desc)], map: "idx_workspace_invitation_workspace_status")
  @@map("workspace_invitation")
}

/// Many-to-many link between a user and a workspace with a role and status.
model WorkspaceMembership {
  id          String    @id
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  role        String    @default("member") /// owner | admin | member.
  status      String    @default("active") /// active | removed.
  joinedAt    DateTime  @map("joined_at") @db.Timestamptz(6) /// When the membership became active.
  invitedBy   String?   @map("invited_by") /// Optional user id who issued the invitation.
  users       Users     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workspaceId, userId])
  @@index([userId], map: "idx_workspace_membership_user")
  @@index([workspaceId], map: "idx_workspace_membership_workspace")
  @@map("workspace_membership")
}

/// In-app notification for a workspace recipient.
model WorkspaceNotification {
  id            String    @id
  workspaceId   String    @map("workspace_id")
  recipientType String    @map("recipient_type") /// human | runtime | channel, etc.
  recipientId   String    @map("recipient_id") /// ID of the recipient within recipientType.
  actorType     String?   @map("actor_type") /// Optional entity type that triggered the notification.
  actorId       String?   @map("actor_id") /// Optional entity id that triggered the notification.
  type          String /// Notification category (e.g. mention, task_assigned).
  resourceType  String    @map("resource_type") /// Target entity type the notification refers to.
  resourceId    String?   @map("resource_id") /// Target entity id the notification refers to.
  channelName   String?   @map("channel_name")
  title         String
  body          String
  actionHref    String?   @map("action_href") /// Optional deep-link for the notification action.
  severity      String    @default("info") /// info | warning | critical.
  status        String    @default("unread") /// unread | read | archived.
  dedupeKey     String?   @map("dedupe_key") /// Optional partial-unique key for upsert semantics.
  metadataJson  Json      @default("{}") @map("metadata_json") /// Extra notification payload.
  createdAt     DateTime  @map("created_at") @db.Timestamptz(6)
  readAt        DateTime? @map("read_at") @db.Timestamptz(6) /// Set when marked read.
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(6) /// Set when archived.
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workspaceId, dedupeKey], map: "idx_workspace_notification_dedupe", where: raw("(dedupe_key IS NOT NULL)"))
  @@index([workspaceId, recipientType, recipientId, status, createdAt(sort: Desc)], map: "idx_workspace_notification_recipient_status_created")
  @@index([workspaceId, resourceType, resourceId, createdAt(sort: Desc)], map: "idx_workspace_notification_resource")
  @@map("workspace_notification")
}

model WorkspaceRuntimeDisplayName {
  workspaceId     String       @map("workspace_id")
  runtimeId       String       @map("runtime_id")
  displayName     String       @map("display_name")
  updatedByUserId String?      @map("updated_by_user_id")
