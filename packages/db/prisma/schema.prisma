  users                Users?               @relation(fields: [rotatedByUserId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  @@id([connectionId, fieldName])
  @@map("runtime_mcp_secret")
}

model RuntimeMcpToolAudit {
