model workspace_channel {
  id                        String                      @id
  workspace_id              String
  name                      String
  kind                      String                      @default("group")
  human_member_names_json   Json                        @default("[]")
  human_member_count        Int                         @default(0)
  employee_names_json       Json                        @default("[]")
  version                   Int                         @default(1)
  created_at                DateTime                    @db.Timestamptz(6)
  updated_at                DateTime                    @db.Timestamptz(6)
  channel_access_request    channel_access_request[]
  channel_invitation        channel_invitation[]
  channel_participant       channel_participant[]
  external_channel_binding  external_channel_binding[]
  external_resource_binding external_resource_binding[]
  external_thread_binding   external_thread_binding[]
  workspace                 workspace                   @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workspace_id, name])
  @@index([workspace_id, name], map: "idx_workspace_channel_workspace")
}

model workspace_employee {
  workspace_id                      String
  name                              String
  role                              String                              @default("Agent")
  remark_name                       String?
  origin                            String                              @default("manual")
  summary                           String                              @default("")
  traits_json                       Json                                @default("[]")
  fit                               String                              @default("")
  status                            String                              @default("active")
  instructions                      String                              @default("")
  owner_user_id                     String?
  channel_member_access             String                              @default("disabled")
  version                           Int                                 @default(1)
  created_at                        DateTime                            @db.Timestamptz(6)
  updated_at                        DateTime                            @db.Timestamptz(6)
  default_model                     String?
  execution_policy_json             Json                                @default("{}")
  id                                String                              @unique(map: "idx_workspace_employee_id") @default(dbgenerated("gen_random_uuid()"))
  agent_knowledge_page              agent_knowledge_page[]
  agent_skill                       agent_skill[]
  agent_skill_requirement_config    agent_skill_requirement_config[]
  employee_artifact                 employee_artifact[]
  employee_persistent_workspace     employee_persistent_workspace[]
  employee_recovery_operation       employee_recovery_operation[]
  employee_runtime_binding          employee_runtime_binding[]
  employee_workspace_revision       employee_workspace_revision[]
  runtime_workspace_mount_operation runtime_workspace_mount_operation[]
  task_commit_journal               task_commit_journal[]
  users                             users?                              @relation(fields: [owner_user_id], references: [id], onUpdate: NoAction)
  workspace                         workspace                           @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([workspace_id, name])
  @@index([workspace_id, name], map: "idx_workspace_employee_workspace")
}

model workspace_git_credential {
  id                 String    @id
  workspace_id       String
  host               String
  credential_type    String
  reference_name     String
  encrypted_secret   String
  fingerprint        String
  status             String    @default("active")
  created_by_user_id String?
  created_at         DateTime  @db.Timestamptz(6)
  updated_at         DateTime  @db.Timestamptz(6)
  rotated_at         DateTime? @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  users              users?    @relation(fields: [created_by_user_id], references: [id], onUpdate: NoAction)
  workspace          workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workspace_id, host])
}

model workspace_invitation {
  id           String    @id
  workspace_id String
  email        String
  role         String    @default("member")
  token_hash   String    @unique
  status       String    @default("active")
  invited_by   String
  created_at   DateTime  @db.Timestamptz(6)
  expires_at   DateTime  @db.Timestamptz(6)
  accepted_at  DateTime? @db.Timestamptz(6)
  workspace    workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspace_id, email, status], map: "idx_workspace_invitation_email")
  @@index([workspace_id, status, created_at(sort: Desc)], map: "idx_workspace_invitation_workspace_status")
}

model workspace_membership {
  id           String    @id
  workspace_id String
  user_id      String
  role         String    @default("member")
  status       String    @default("active")
  joined_at    DateTime  @db.Timestamptz(6)
  invited_by   String?
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspace    workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workspace_id, user_id])
  @@index([user_id], map: "idx_workspace_membership_user")
  @@index([workspace_id], map: "idx_workspace_membership_workspace")
}

model workspace_notification {
  id             String    @id
  workspace_id   String
  recipient_type String
  recipient_id   String
  actor_type     String?
  actor_id       String?
  type           String
  resource_type  String
  resource_id    String?
  channel_name   String?
  title          String
  body           String
  action_href    String?
  severity       String    @default("info")
  status         String    @default("unread")
  dedupe_key     String?
  metadata_json  Json      @default("{}")
  created_at     DateTime  @db.Timestamptz(6)
  read_at        DateTime? @db.Timestamptz(6)
  archived_at    DateTime? @db.Timestamptz(6)
  workspace      workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workspace_id, dedupe_key], map: "idx_workspace_notification_dedupe", where: raw("(dedupe_key IS NOT NULL)"))
  @@index([workspace_id, recipient_type, recipient_id, status, created_at(sort: Desc)], map: "idx_workspace_notification_recipient_status_created")
  @@index([workspace_id, resource_type, resource_id, created_at(sort: Desc)], map: "idx_workspace_notification_resource")
}

model workspace_runtime_display_name {
  workspace_id       String
  runtime_id         String
  display_name       String
  updated_by_user_id String?
  created_at         DateTime      @db.Timestamptz(6)
  updated_at         DateTime      @db.Timestamptz(6)
  agent_runtime      agent_runtime @relation(fields: [runtime_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users              users?        @relation(fields: [updated_by_user_id], references: [id], onUpdate: NoAction)
  workspace          workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([workspace_id, runtime_id])
}

model workspace_runtime_grant {
  id                                                      String        @id
  workspace_id                                            String
  runtime_id                                              String
  user_id                                                 String
  permission                                              String        @default("use")
  status                                                  String        @default("active")
  granted_by_user_id                                      String
  created_at                                              DateTime      @db.Timestamptz(6)
  updated_at                                              DateTime      @db.Timestamptz(6)
  revoked_at                                              DateTime?     @db.Timestamptz(6)
  users_workspace_runtime_grant_granted_by_user_idTousers users         @relation("workspace_runtime_grant_granted_by_user_idTousers", fields: [granted_by_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agent_runtime                                           agent_runtime @relation(fields: [runtime_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_workspace_runtime_grant_user_idTousers            users         @relation("workspace_runtime_grant_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspace                                               workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workspace_id, runtime_id, user_id, permission])
  @@index([workspace_id, runtime_id, status], map: "idx_workspace_runtime_grant_runtime")
  @@index([workspace_id, user_id, status], map: "idx_workspace_runtime_grant_user")
}

model workspace_service_secret {
  id                    String                @id
  workspace_id          String
  service_catalog_id    String
  name                  String
  encrypted_value       String
  created_at            DateTime              @db.Timestamptz(6)
  updated_at            DateTime              @db.Timestamptz(6)
  skill_service_catalog skill_service_catalog @relation(fields: [service_catalog_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspace             workspace             @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workspace_id, service_catalog_id, name])
}

model workspace_snapshot {
  id                String   @id
  organization_name String
  pending_handoffs  Int      @default(0)
  state_json        Json
  state_version     Int      @default(1)
  created_at        DateTime @db.Timestamptz(6)
  updated_at        DateTime @db.Timestamptz(6)
}

model workspace_sso_binding {
  workspace_id String    @id
  tenant_id    String    @unique(map: "idx_workspace_sso_binding_tenant_unique", where: raw("(source = 'tenant'::text)"))
  tenant_slug  String?
  tenant_name  String
  team_id      String?   @unique(map: "idx_workspace_sso_binding_team_unique", where: raw("(team_id IS NOT NULL)"))
  team_slug    String?
  team_name    String?
  source       String
  synced_at    DateTime  @db.Timestamptz(6)
  workspace    workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([team_id], map: "idx_workspace_sso_binding_team")
}

model workspace_task {
  id           String    @id
  workspace_id String
  title        String
  channel_name String
  assignee     String
  priority     String
  status       String
  sort_order   Int?
  labels_json  Json      @default("[]")
  version      Int       @default(1)
  created_at   DateTime  @db.Timestamptz(6)
  updated_at   DateTime  @db.Timestamptz(6)
  workspace    workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspace_id, status, updated_at], map: "idx_workspace_task_workspace")
}
