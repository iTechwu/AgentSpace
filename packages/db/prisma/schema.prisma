  resolver_user_id                                    String?
  resolved_at                                         DateTime?              @db.Timestamptz(6)
  created_at                                          DateTime               @db.Timestamptz(6)
  updated_at                                          DateTime               @db.Timestamptz(6)
  fork_invitation_id                                  String?
  audit_data_json                                     Json                   @default("{}")
  agent_fork_invitation                               agent_fork_invitation? @relation(fields: [fork_invitation_id], references: [id], onUpdate: NoAction)
  users_agent_access_request_requester_user_idTousers users                  @relation("agent_access_request_requester_user_idTousers", fields: [requester_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_agent_access_request_resolver_user_idTousers  users?                 @relation("agent_access_request_resolver_user_idTousers", fields: [resolver_user_id], references: [id], onUpdate: NoAction)
