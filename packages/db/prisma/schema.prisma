// AgentSpace Prisma schema.
//
// Phase 0 (Route A): Prisma owns schema/migration governance only; the legacy
// sync SQL Repository (getDatabase/prepare) remains the runtime access layer.
//
// This file is the SCAFFOLD. The full model set is generated by `prisma db pull`
// from the desensitized test database (agent_space_test, schema version 116) and
// then hand-cleaned. See docs/0808/db_migration_to_prisma/README.md.
//
// Objects Prisma cannot represent (5 triggers, 5 functions, pgcrypto, 3 expression
// indexes, 2 CREATE INDEX CONCURRENTLY, compound CHECKs) are NOT declared here —
// they live as raw SQL inside prisma/migrations/0_init/migration.sql.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

// In Prisma 7 the connection URL no longer lives in schema.prisma.
// It is provided to migrate/introspection via prisma.config.ts (`datasource.url`)
// and to the runtime client via the @prisma/adapter-pg adapter constructor.
datasource db {
  provider = "postgresql"
}
