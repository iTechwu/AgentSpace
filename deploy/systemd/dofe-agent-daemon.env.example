# DofeAgent remote daemon environment template
# Copy to /etc/dofe-agent/daemon.env and fill real values.

DOFE_AGENT_SERVER_URL=https://your-dofe-agent-domain
DOFE_AGENT_DAEMON_TOKEN=replace_with_daemon_token
DOFE_AGENT_DAEMON_ID=daemon-prod-01
DOFE_AGENT_DEVICE_NAME=prod-daemon-host-01
DOFE_AGENT_RUNTIME_NAME=Remote Agent
DOFE_AGENT_DAEMON_STATE_DIR=/var/lib/dofe-agent-daemon
DOFE_AGENT_TASK_TIMEOUT_MS=43200000
# Optional provider-specific overrides
CLAUDE_MODEL=claude-haiku-4-5-20251001
ANTIGRAVITY_MODEL=Gemini 3.5 Flash
GEMINI_MODEL=gemini-2.0-flash-lite
OPENCODE_MODEL=openrouter/openai/gpt-4.1
# OpenClaw uses AgentRouter only. OpenClaw 2026.3.3 has no explicit
# `openclaw agent --model`, so daemon passes model as OPENCLAW_MODEL.
OPENCLAW_PROFILE=default
OPENCLAW_MODEL=openrouter/openai/gpt-4.1
# Optional thinking mode passed as `openclaw agent --thinking`.
OPENCLAW_THINKING=medium
NANOBOT_MODEL=openai/gpt-5-mini
NANOBOT_CONFIG_PATH=/etc/dofe-agent/nanobot.json
