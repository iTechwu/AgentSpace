# External shared database managed by ../docker-helm.dofe.ai.
DATABASE_URL=replace_with_external_shared_database_url

WORKFLOW_WORKER_ID=workflow-worker-prod-01
WORKFLOW_WORKER_POLL_MS=1000
WORKFLOW_WORKER_BATCH_SIZE=20
WORKFLOW_WORKER_TICK_TIMEOUT_MS=30000

# Start with legacy_only, migrate, then advance workspace-by-workspace.
WORKFLOW_CUTOVER_MODE=legacy_only
WORKFLOW_CUTOVER_MODES={}

# Must match the Web recovery Cron secret. Do not commit a real value.
CRON_SECRET=replace_with_a_long_random_secret
