[Unit]
Description=DofeAgent Feishu WebSocket Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/DofeAgent
ExecStart=/usr/bin/npm run cli -- integrations feishu worker --workspace-id ${DOFE_AGENT_WORKSPACE_ID}
Restart=always
RestartSec=5
TimeoutStopSec=20
User=www-data
Environment=NODE_ENV=production
EnvironmentFile=/etc/dofe-agent/feishu-worker.env

[Install]
WantedBy=multi-user.target
