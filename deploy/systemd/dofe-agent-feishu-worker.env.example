# DofeAgent Feishu WebSocket worker environment.
# Copy to /etc/dofe-agent/feishu-worker.env for deploy/systemd/dofe-agent-feishu-worker.service.

DOFE_AGENT_WORKSPACE_ID=default

# PostgreSQL primary database. Use the same database as the DofeAgent web app.
DOFE_AGENT_PG_URL=postgres://dofe_agent:dofe_agent@127.0.0.1:5432/dofe_agent
DATABASE_URL=postgres://dofe_agent:dofe_agent@127.0.0.1:5432/dofe_agent

# Required to decrypt Feishu app_secret / verification_token / encrypt_key saved by the web UI.
# Must match the key used by the web app when the Feishu integration was created.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOFE_AGENT_FEISHU_CREDENTIAL_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# Optional: restrict this worker to one integration id.
DOFE_AGENT_FEISHU_INTEGRATION_ID=

# Optional: identify this worker in outbox locks and logs.
DOFE_AGENT_FEISHU_WORKER_ID=feishu-worker-prod-01

# Optional: use accounts.larksuite.com for Lark tenants instead of the default Feishu domain.
DOFE_AGENT_FEISHU_WS_DOMAIN=

# Optional: override Feishu API base URL for private/test environments.
DOFE_AGENT_FEISHU_API_BASE_URL=
