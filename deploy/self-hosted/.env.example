# External PostgreSQL. This Compose stack never starts or persists a database.
# The host must be reachable from Docker, for example host.docker.internal on Docker Desktop.
SELF_HOSTED_DATABASE_URL=postgres://dofe_agent:replace_with_a_long_database_password@replace_with_external_postgres_host:5432/dofe_agent
SELF_HOSTED_DATABASE_DIRECT_URL=postgres://dofe_agent:replace_with_a_long_database_password@replace_with_external_postgres_host:5432/dofe_agent
DATABASE_URL=postgres://dofe_agent:replace_with_a_long_database_password@replace_with_external_postgres_host:5432/dofe_agent

DOFE_AGENT_HTTP_PORT=1455
DOFE_AGENT_APP_URL=https://dofe-agent.example.com
DOFE_AGENT_WORKSPACE_ID=replace_with_workspace_id
DOFE_AGENT_RUNTIME_MODE=local
MODELS_BASE_URL=https://models.example.com
MODELS_GATEWAY_BASE_URL=https://model.example.com
OPENMONTAGE_MODELS_BASE_URL=http://host.docker.internal:3101/api
MANAGED_RUNTIME_PREFLIGHT_CHARGE_USD=0.01
DOFE_AGENT_RUNTIME_CREDENTIAL_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
DOFE_AGENT_RUNTIME_CREDENTIAL_VAULT_DIR=/srv/DofeAgent/data/runtime-credential-vault
# OpenMontage is deployed separately and must connect to this web service's
# `/api/internal/openmontage/events` endpoint. Keep both secrets independent.
OPENMONTAGE_BASE_URL=http://host.docker.internal:8765
OPENMONTAGE_MCP_URL=http://host.docker.internal:8765/mcp
OPENMONTAGE_SERVICE_TOKEN=replace_with_a_long_random_service_token
OPENMONTAGE_EVENT_SIGNING_SECRET=replace_with_a_different_long_random_signing_secret
MANAGED_RUNTIME_IMAGE_TAG=latest
MANAGED_RUNTIME_DOCKER_NETWORK=dofe-models-egress
# Catalog admission accepts image templates only from these registries.
DOFE_AGENT_SKILL_SERVICE_ALLOWED_REGISTRIES=docker.io,ghcr.io
MANAGED_RUNTIME_NETWORK_POLICY_LABEL=dofe.managed-egress=restricted
# Comma-separated upstream URLs that must be unreachable from the managed Runtime network.
MANAGED_RUNTIME_BLOCKED_EGRESS_URLS=https://api.openai.com,https://api.anthropic.com,https://generativelanguage.googleapis.com
# Known public IP:port targets must also be unreachable, proving raw-IP egress is denied.
MANAGED_RUNTIME_BLOCKED_EGRESS_IPS=1.1.1.1:443,8.8.8.8:443
# Replace with every organization proxy endpoint that could bypass the Provider deny policy.
MANAGED_RUNTIME_BLOCKED_PROXY_URLS=http://replace_with_corporate_proxy_host:8080
MANAGED_RUNTIME_EVIDENCE_DIR=artifacts/managed-runtime
# Populate these after issuing one real staging request, then run the billing release gate.
STAGING_MODELS_TENANT_ID=replace_with_models_tenant_id
STAGING_RUNTIME_CREDENTIAL_ID=replace_with_runtime_credential_id
STAGING_RUNTIME_ID=replace_with_runtime_id
STAGING_EMPLOYEE_ID=replace_with_employee_id
STAGING_CONVERSATION_ID=replace_with_conversation_id
STAGING_GATEWAY_REQUEST_ID=replace_with_gateway_request_id
STAGING_EXPECTED_MODEL=replace_with_model_id
STAGING_BILLING_START_DATE=2026-07-28T00:00:00.000Z
CRON_SECRET=replace_with_a_long_random_secret
DOFE_AGENT_RUNTIME_MAINTENANCE_INTERVAL_MS=30000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
DOFE_AGENT_FEISHU_CREDENTIAL_ENCRYPTION_KEY=replace_with_the_key_used_to_encrypt_feishu_credentials

# The daemon images install one provider each. Review and pin these versions before deployment.
CLAUDE_PROVIDER_INSTALL_COMMAND=pnpm add --global @anthropic-ai/claude-code@2.1.218
CODEX_PROVIDER_INSTALL_COMMAND=pnpm add --global @openai/codex@0.145.0

DOFE_AGENT_CLAUDE_DAEMON_ID=docker-claude
DOFE_AGENT_CLAUDE_DEVICE_NAME=DofeAgent Docker Claude
DOFE_AGENT_CLAUDE_RUNTIME_NAME=DofeAgent Docker Claude Runtime
DOFE_AGENT_CLAUDE_PROVIDER_ACCOUNT_ID=provider-account_xxx
DOFE_AGENT_CLAUDE_PROVIDER_CREDENTIAL_DIR=./credentials/claude
DOFE_AGENT_CODEX_DAEMON_ID=docker-codex
DOFE_AGENT_CODEX_DEVICE_NAME=DofeAgent Docker Codex
DOFE_AGENT_CODEX_RUNTIME_NAME=DofeAgent Docker Codex Runtime
DOFE_AGENT_CODEX_PROVIDER_ACCOUNT_ID=provider-account_xxx
DOFE_AGENT_CODEX_PROVIDER_CREDENTIAL_DIR=./credentials/codex
DOFE_AGENT_HEARTBEAT_INTERVAL_MS=15000
DOFE_AGENT_TASK_TIMEOUT_MS=43200000

# SSO and attachment storage settings. Fill the values required by your deployment.
SSO_API_URL=https://sso.example.com/api
SSO_INTERNAL_API_URL=https://sso.example.com/api
SSO_ISSUER=https://sso.example.com/api
SSO_CLIENT_ID=replace_with_sso_client_id
SSO_CLIENT_SECRET=replace_with_sso_client_secret
SSO_SERVICE_NAME=dofe-agent.example.com
INTERNAL_API_SECRET=replace_with_internal_api_secret
SSO_REDIRECT_URI=https://dofe-agent.example.com/auth/callback
JWKS_URI=https://sso.example.com/api/.well-known/jwks.json
SSO_DISCOVERY_URL=https://sso.example.com/api/.well-known/openid-configuration
