# Copy to deepseek-harness.env and replace every placeholder. Never put a DeepSeek API key here.
DOFE_AGENT_SERVER_URL=https://dofe-agent.example.com
DOFE_AGENT_DAEMON_TOKEN=replace-with-a-dedicated-daemon-token
DOFE_AGENT_DAEMON_ID=replace-with-a-unique-deepseek-harness-daemon-id
DOFE_AGENT_DEVICE_NAME=replace-with-a-deepseek-harness-runtime-device-name
DOFE_AGENT_RUNTIME_NAME=DeepSeek Harness
DOFE_AGENT_RUNTIME_PROVIDER=deepseek-harness
DOFE_AGENT_PROVIDER_ACCOUNT_ID=provider-account_xxx
DOFE_AGENT_PROVIDER_CREDENTIAL_ROOT=/run/dofe-agent-provider
DOFE_AGENT_PROVIDER_CREDENTIAL_MAP_REF=file:///run/dofe-agent-provider/provider-accounts.json
DOFE_AGENT_TASK_TIMEOUT_MS=43200000
DSH_HOME=/home/dofe-agent/.dsh

# Standalone JSON-RPC queue admission. Keep disabled until an operator-built
# dsh-jsonrpc-agent and reviewed Cordis composition are present in this runtime.
# The digests pin carrier, Cordis config, and required native sidecars; paths must
# be absolute. Managed launchers require the image-baked attestation plus these pins.
DOFE_AGENT_DEEPSEEK_JSONRPC_ENABLED=0
# Managed images supply the next two values. Standalone operators must set
# absolute carrier paths and build-verified digests in their private env file.
# DOFE_AGENT_DEEPSEEK_JSONRPC_EXECUTABLE=/absolute/path/to/dsh-jsonrpc-agent
# DOFE_AGENT_DEEPSEEK_JSONRPC_EXECUTABLE_SHA256=
# Deploy the reviewed file from ./deepseek-jsonrpc/cordis.yml at this path.
DOFE_AGENT_DEEPSEEK_JSONRPC_CORDIS_CONFIG=/etc/dofe-agent/deepseek-jsonrpc/cordis.yml
DOFE_AGENT_DEEPSEEK_JSONRPC_CORDIS_CONFIG_SHA256=048031be7331f2b68c81b3cbfacacc06ee767dae1e8f00cbdc3137c1e55001af
# DOFE_AGENT_DEEPSEEK_JSONRPC_RIPGREP_SHA256=
# Required on macOS; ignored on Linux when empty.
# DOFE_AGENT_DEEPSEEK_JSONRPC_SPAWN_HELPER_SHA256=
# The dedicated managed image supplies MANAGED_BUNDLE, PROVENANCE,
# SOURCE_COMMIT, and WHEEL_SHA256 from its verified build inputs. Do not copy
# those managed-only values into a standalone runtime environment.

# Required only when the DofeAgent endpoint uses a private CA.
# NODE_EXTRA_CA_CERTS=/run/certs/dofe-agent-root-ca.pem
