# Copy to deepseek-harness.env and replace every placeholder. Never put a DeepSeek API key here.
DOFE_AGENT_SERVER_URL=https://dofe-agent.example.com
DOFE_AGENT_DAEMON_TOKEN=replace-with-a-dedicated-daemon-token
DOFE_AGENT_DAEMON_ID=replace-with-a-unique-deepseek-harness-daemon-id
DOFE_AGENT_DEVICE_NAME=replace-with-a-deepseek-harness-runtime-device-name
DOFE_AGENT_RUNTIME_NAME=DeepSeek Harness
DOFE_AGENT_RUNTIME_PROVIDER=deepseek-harness
DOFE_AGENT_PROVIDER_ACCOUNT_ID=provider-account_xxx
DOFE_AGENT_PROVIDER_CREDENTIAL_ROOT=/run/dofe-agent-provider
DOFE_AGENT_PROVIDER_CREDENTIAL_MAP_REF=file:///run/dofe-agent-provider/provider-accounts.json
DOFE_AGENT_TASK_TIMEOUT_MS=43200000
DSH_HOME=/home/dofe-agent/.dsh

# Required only when the DofeAgent endpoint uses a private CA.
# NODE_EXTRA_CA_CERTS=/run/certs/dofe-agent-root-ca.pem
