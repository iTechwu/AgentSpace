# Copy this file once per runtime as codex.env, claude.env, openclaw.env, or hermes.env.
# Do not reuse a token or daemon ID across containers.
DOFE_AGENT_SERVER_URL=https://dofe-agent.example.com
DOFE_AGENT_DAEMON_TOKEN=replace-with-a-dedicated-daemon-token
DOFE_AGENT_DAEMON_ID=replace-with-a-unique-daemon-id
DOFE_AGENT_DEVICE_NAME=replace-with-a-runtime-device-name
DOFE_AGENT_RUNTIME_NAME=replace-with-a-single-provider-runtime-name
# Set one of: codex, claude, openclaw, hermes. This is an enforced registration allowlist.
DOFE_AGENT_RUNTIME_PROVIDER=replace-with-the-single-installed-provider
# Codex defaults to workspace-write. Do not set danger-full-access in normal deployments.
# DOFE_AGENT_CODEX_SANDBOX=workspace-write
DOFE_AGENT_TASK_TIMEOUT_MS=43200000

# Required only when the DofeAgent endpoint uses a private CA.
# Mount the CA PEM into the container and set this to its in-container path.
# NODE_EXTRA_CA_CERTS=/run/certs/dofe-agent-root-ca.pem
