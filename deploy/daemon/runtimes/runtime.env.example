# Copy this file once per runtime as codex.env, claude.env, openclaw.env, or hermes.env.
# Do not reuse a token or daemon ID across containers.
AGENT_SPACE_SERVER_URL=https://agentspace.example.com
AGENT_SPACE_DAEMON_TOKEN=replace-with-a-dedicated-daemon-token
AGENT_SPACE_DAEMON_ID=replace-with-a-unique-daemon-id
AGENT_SPACE_DEVICE_NAME=replace-with-a-runtime-device-name
AGENT_SPACE_RUNTIME_NAME=replace-with-a-single-provider-runtime-name
# Set one of: codex, claude, openclaw, hermes. This is an enforced registration allowlist.
AGENT_SPACE_RUNTIME_PROVIDER=replace-with-the-single-installed-provider
# Codex defaults to workspace-write. Do not set danger-full-access in normal deployments.
# AGENT_SPACE_CODEX_SANDBOX=workspace-write
AGENT_SPACE_TASK_TIMEOUT_MS=43200000

# Required only when the AgentSpace endpoint uses a private CA.
# Mount the CA PEM into the container and set this to its in-container path.
# NODE_EXTRA_CA_CERTS=/run/certs/agent-space-root-ca.pem
