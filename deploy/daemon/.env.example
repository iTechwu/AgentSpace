# Build each image with exactly one provider CLI installation command.
# Pin provider versions in your deployment environment.
MANAGED_NODE_ENV_FILE=./.env.managed-node
CODEX_PROVIDER_INSTALL_COMMAND=pnpm add --global @openai/codex
CLAUDE_PROVIDER_INSTALL_COMMAND=pnpm add --global @anthropic-ai/claude-code
OPENCLAW_PROVIDER_INSTALL_COMMAND=pnpm add --global openclaw
# Set the Hermes installation command supplied by your approved Hermes distribution.
HERMES_PROVIDER_INSTALL_COMMAND=replace-with-approved-hermes-install-command
CODEX_PROVIDER_CREDENTIAL_DIR=./credentials/codex
CLAUDE_PROVIDER_CREDENTIAL_DIR=./credentials/claude
OPENCLAW_PROVIDER_CREDENTIAL_DIR=./credentials/openclaw
HERMES_PROVIDER_CREDENTIAL_DIR=./credentials/hermes

# OpenMontage is deployed separately. The daemon resolves the platform-owned
# managed-service reference to this private MCP endpoint and never exposes it to
# the Runtime or browser. Use the same service token as the OpenMontage service.
OPENMONTAGE_MCP_URL=http://host.docker.internal:8765/mcp
OPENMONTAGE_SERVICE_TOKEN=replace_with_a_long_random_service_token
