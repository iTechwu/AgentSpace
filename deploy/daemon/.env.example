# Pin provider versions and build inputs in your deployment environment.
# Non-DeepSeek wrappers use one provider CLI installation command; DeepSeek
# consumes the separately built JSON-RPC bundle configured below.
MANAGED_NODE_ENV_FILE=./.env.managed-node
CODEX_PROVIDER_INSTALL_COMMAND=pnpm add --global @openai/codex
CLAUDE_PROVIDER_INSTALL_COMMAND=pnpm add --global @anthropic-ai/claude-code
OPENCLAW_PROVIDER_INSTALL_COMMAND=pnpm add --global openclaw
# Set the Hermes installation command supplied by your approved Hermes distribution.
HERMES_PROVIDER_INSTALL_COMMAND=replace-with-approved-hermes-install-command
# Approved base used by docker-compose.remote-images.yml.
DEEPSEEK_HARNESS_PROVIDER_BASE_IMAGE=uhub.service.ucloud.cn/techwu/node:24.19-bookworm-slim
# Fixed-tag production bundle build context and independently recorded digests.
DEEPSEEK_HARNESS_RUNTIME_BUNDLE_CONTEXT=./runtimes/deepseek-jsonrpc/artifacts/linux-amd64
DEEPSEEK_RUNTIME_SOURCE_COMMIT=b150a551b8d465e31e418e1b2eaf5e79bbb7d28e
DEEPSEEK_RUNTIME_WHEEL_SHA256=replace-with-lowercase-64-character-sha256
DEEPSEEK_JSONRPC_EXECUTABLE_SHA256=replace-with-lowercase-64-character-sha256
DEEPSEEK_JSONRPC_RIPGREP_SHA256=replace-with-lowercase-64-character-sha256
DEEPSEEK_RUNTIME_EVIDENCE_OUTPUT=/absolute/path/to/deepseek-release-evidence.json
# Post-push canary inputs. The dedicated remote DeepSeek Compose service consumes the same
# immutable DEEPSEEK_RUNTIME_IMAGE after the canary passes. Supply
# DEEPSEEK_API_KEY separately from the test environment secret store; never
# commit it to this file.
DEEPSEEK_RUNTIME_IMAGE=registry.example/dofe/agent-runtime-deepseek-harness@sha256:replace-with-lowercase-64-character-digest
DEEPSEEK_RUNTIME_IMAGE_REPOSITORY=registry.example/dofe/agent-runtime-deepseek-harness
DEEPSEEK_RUNTIME_IMAGE_SHA256=replace-with-lowercase-64-character-digest-without-prefix
DEEPSEEK_RUNTIME_RELEASE_EVIDENCE=/absolute/path/to/deepseek-release-evidence.json
DEEPSEEK_RUNTIME_COSIGN_PUBLIC_KEY=/absolute/path/to/deepseek-runtime-cosign.pub
DEEPSEEK_RUNTIME_COSIGN_PUBLIC_KEY_SHA256=replace-with-approved-lowercase-64-character-sha256
# Optional; defaults to 60 seconds and is bounded to 1..300.
DEEPSEEK_RUNTIME_COSIGN_TIMEOUT_SECONDS=60
DEEPSEEK_MODEL_CANARY_EVIDENCE_OUTPUT=/absolute/path/to/deepseek-model-canary-evidence.json
CODEX_PROVIDER_CREDENTIAL_DIR=./credentials/codex
CLAUDE_PROVIDER_CREDENTIAL_DIR=./credentials/claude
OPENCLAW_PROVIDER_CREDENTIAL_DIR=./credentials/openclaw
HERMES_PROVIDER_CREDENTIAL_DIR=./credentials/hermes
DEEPSEEK_HARNESS_PROVIDER_CREDENTIAL_DIR=./credentials/deepseek-harness

# OpenMontage is deployed separately. The daemon resolves the platform-owned
# managed-service reference to this private MCP endpoint and never exposes it to
# the Runtime or browser. Use the same service token as the OpenMontage service.
OPENMONTAGE_MCP_URL=http://host.docker.internal:8765/mcp
OPENMONTAGE_SERVICE_TOKEN=replace_with_a_long_random_service_token
TOOLS_VIRAL_VIDEO_MCP_URL=http://host.docker.internal:13103/mcp/viral-video
# Keep disabled by default; enable only for an explicitly approved Codex MCP canary.
MCP_CODEX_EXPERIMENTAL_ENABLED=0
