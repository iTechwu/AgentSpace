# The provider image is a build argument because every runtime wrapper uses a
# different approved base image. It must be global to remain visible to the
# second FROM in this multi-stage Dockerfile.
ARG PROVIDER_BASE_IMAGE

# Build the daemon package from the checked-out source so approved runtime
# images never depend on a manually staged tarball in deploy/daemon.
FROM uhub.service.ucloud.cn/techwu/node:25.9-bookworm-slim AS daemon-build

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    PNPM_CONFIG_REGISTRY=https://registry.npmmirror.com \
    PNPM_CONFIG_REPLACE_REGISTRY_HOST=always

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/cli ./apps/cli
COPY packages ./packages

RUN corepack enable \
  && corepack prepare pnpm@10.26.2 --activate \
  && pnpm install --frozen-lockfile --ignore-scripts \
  && pnpm --filter dofe-agent-daemon run build \
  && mkdir -p /opt/daemon-package \
  && pnpm --filter dofe-agent-daemon pack --ignore-scripts --pack-destination /opt/daemon-package

# Build a runtime wrapper around an already approved provider image. The base
# image must contain Node.js with Corepack available and exactly one supported provider CLI.
FROM ${PROVIDER_BASE_IMAGE}

USER root

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH

ARG PROVIDER_PATH=""

RUN groupadd --gid 10001 dofe-agent \
  && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/dofe-agent --shell /usr/sbin/nologin dofe-agent

COPY --from=daemon-build /opt/daemon-package/dofe-agent-daemon-*.tgz /tmp/

RUN corepack enable \
  && corepack prepare pnpm@10.26.2 --activate \
  && pnpm add --global /tmp/dofe-agent-daemon-*.tgz \
  && rm /tmp/dofe-agent-daemon-*.tgz \
  && mkdir -p /var/lib/dofe-agent-daemon \
  && chown -R dofe-agent:dofe-agent /home/dofe-agent /var/lib/dofe-agent-daemon

ENV HOME=/home/dofe-agent \
    DOFE_AGENT_DAEMON_STATE_DIR=/var/lib/dofe-agent-daemon \
    NODE_ENV=production \
    PROVIDER_PATH=${PROVIDER_PATH}
ENV PATH=${PROVIDER_PATH}:${PATH}

USER dofe-agent

ENTRYPOINT ["dofe-agent-daemon", "start", "--foreground"]
