DOFE_AGENT_SERVER_URL=http://host.docker.internal:1455
DOFE_AGENT_DAEMON_TOKEN=replace-with-one-time-daemon-token
DOFE_AGENT_DAEMON_ID=local-docker-managed-node
DOFE_AGENT_DEVICE_NAME=Local Docker
DOFE_AGENT_RUNTIME_NAME=Managed execution node
MANAGED_NODE_STATE_DIR=/absolute/host/path/to/managed-node-state
MANAGED_NODE_USER=0:0
# Absolute path to the CA that signs DOFE_AGENT_SERVER_URL when it is private
# (for example, a test environment using mkcert). Leave empty for public TLS.
MANAGED_NODE_TLS_CA_PATH=
# Optional connectivity passed to dynamically created provider containers. Use
# host-gateway only when the model endpoint resolves to the Docker host, e.g.
# model.local.dofe.ai:host-gateway for the local Models API.
MANAGED_RUNTIME_DOCKER_EXTRA_HOSTS=
# Absolute host path of the CA used by provider-container gateway requests.
MANAGED_RUNTIME_TLS_CA_PATH=
MANAGED_RUNTIME_DOCKER_NETWORK=common_network
MANAGED_RUNTIME_IMAGE_TAG=latest
# Comma-separated HTTPS origins allowed for immutable Skill blob downloads.
# Include scheme and optional port, but no path/query/credentials.
DOFE_AGENT_SKILL_ARTIFACT_DOWNLOAD_ORIGINS=https://attachments.example.com
# Private/special-address origins are denied unless also listed here. Keep empty
# for public object storage; use only for audited internal HTTPS blob proxies.
DOFE_AGENT_SKILL_ARTIFACT_PRIVATE_DOWNLOAD_ORIGINS=
