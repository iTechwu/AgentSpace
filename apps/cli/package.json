{
  "name": "@dofe-agent/cli",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "dofe-agent": "./bin/dofe-agent.js"
  },
  "scripts": {
    "dofe-agent": "node --experimental-strip-types src/index.ts",
    "pretest": "pnpm --dir ../../packages/daemon run build",
    "test": "sh -c 'node --env-file-if-exists=../../.env --experimental-strip-types --test --test-concurrency=1 src/commands/output.test.ts src/lib/daemon-client.test.ts src/lib/daemon-task-context.test.ts src/lib/task-completion-token-usage.test.ts' --",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dofe-agent/db": "workspace:*",
    "@dofe-agent/domain": "workspace:*",
    "@dofe-agent/services": "workspace:*",
    "dofe-agent-daemon": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  }
}
