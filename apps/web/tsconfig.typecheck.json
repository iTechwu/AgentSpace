{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./*"
      ],
      "@dofe-agent/domain": [
        "../../packages/domain/dist-types/index.d.ts"
      ],
      "@dofe-agent/domain/*": [
        "../../packages/domain/dist-types/*"
      ],
      "@dofe-agent/services": [
        "../../packages/services/dist-types/index.d.ts"
      ],
      "@dofe-agent/services/*": [
        "../../packages/services/dist-types/*"
      ],
      "@dofe-agent/db": [
