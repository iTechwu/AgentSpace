      ],
      "@dofe-agent/db/*": [
        "../../packages/db/dist-types/*"
      ],
      "dofe-agent-daemon": [
        "../../packages/daemon/dist-types/index.d.ts"
      ],
      "dofe-agent-daemon/agent-router": [
        "../../packages/daemon/dist-types/agent-router/index.d.ts"
      ],
      "dofe-agent-daemon/daemon-client": [
        "../../packages/daemon/dist-types/daemon-client.d.ts"
