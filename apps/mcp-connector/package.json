{
  "name": "@dofe-agent/mcp-connector",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "dofe-mcp-connector": "./bin/dofe-mcp-connector.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node25 --outfile=dist/index.js",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "dev": "node --env-file-if-exists=../../.env --experimental-strip-types src/index.ts",
    "test": "sh -c 'node --env-file-if-exists=../../.env --experimental-strip-types --test --test-concurrency=1 src/**/*.test.ts' --",
    "types": "tsc -p tsconfig.json --incremental false"
  },
  "dependencies": {
    "@dofe-agent/domain": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^25.9.0"
  }
}
