{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "@dofe-agent/cli#test": {
      "dependsOn": ["^test", "@dofe-agent/web#test"],
      "outputs": []
    },
    "@dofe-agent/workflow-worker#test": {
      "dependsOn": ["^test"],
      "outputs": []
    }
  }
}
